---
// Round "Teilen" buttons (WhatsApp, copy link, Facebook) used on event pages
import { SITE_URL } from '../lib/site';

interface Props {
  path: string;
  label?: string;
  labelColor?: string;
}
const { path, label = 'Teilen', labelColor = 'var(--sand)' } = Astro.props;
const url = SITE_URL + path;
---
<div class="share" data-share-url={url}>
  <span class="share-label" style={`color:${labelColor}`}>{label}</span>
  <a class="btn" href={`https://api.whatsapp.com/send/?phone&text=${url}`} target="_blank" rel="noreferrer noopener" aria-label="Auf WhatsApp teilen" data-popup>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.2h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg>
  </a>
  <button class="btn" type="button" aria-label="Link kopieren" data-copy>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" d="M10.6 13.4a3.6 3.6 0 0 0 5.1 0l3.2-3.2a3.6 3.6 0 0 0-5.1-5.1l-1.4 1.4M13.4 10.6a3.6 3.6 0 0 0-5.1 0l-3.2 3.2a3.6 3.6 0 0 0 5.1 5.1l1.4-1.4"/></svg>
  </button>
  <a class="btn" href={`https://facebook.com/sharer/sharer.php?u=${url}`} target="_blank" rel="noreferrer noopener" aria-label="Auf Facebook teilen" data-popup>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.92 3.78-3.92 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.79 8.43-4.94 8.43-9.94z"/></svg>
  </a>
  <span class="toast" role="status" aria-live="polite"></span>
</div>

<style>
  .share { position: relative; display: inline-flex; align-items: center; gap: 5px; }
  .share-label { font: 400 16px/1 var(--f-sans); letter-spacing: .01em; margin-right: 12px; }
  .btn { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: var(--sand-2); color: #000; transition: filter .2s; }
  .btn:hover { filter: brightness(1.1); }
  .btn svg { width: 26px; height: 26px; }
  .toast { position: absolute; left: 50%; top: calc(100% + 6px); transform: translateX(-50%); font: 12px var(--f-sans); background: #fff; color: #000; padding: 4px 8px; border-radius: 3px; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity .2s; }
  .toast.show { opacity: 1; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-share-url]').forEach((box) => {
    const url = box.dataset.shareUrl!;
    const toast = box.querySelector<HTMLElement>('.toast')!;
    box.querySelector('[data-copy]')?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(url); toast.textContent = 'Link kopiert'; }
      catch { toast.textContent = url; }
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2000);
    });
    box.querySelectorAll<HTMLAnchorElement>('[data-popup]').forEach((a) => a.addEventListener('click', (e) => {
      const w = window.open(a.href, 'share', 'width=600,height=500,noopener');
      if (w) e.preventDefault();
    }));
  });
</script>
