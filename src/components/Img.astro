---
import { Image } from 'astro:assets';
import { media } from '../lib/media';

interface Props {
  /** file name in src/assets/media */
  src: string;
  alt?: string;
  /** rendered CSS width in px on desktop (used for srcset generation) */
  w: number;
  /** rendered CSS height in px on desktop (box is cropped with object-fit) */
  h?: number;
  class?: string;
  style?: string;
  loading?: 'lazy' | 'eager';
  fit?: 'cover' | 'contain';
  sizes?: string;
  quality?: number;
}

const { src, alt = '', w, h, class: cls, style, loading = 'lazy', fit = 'cover', sizes, quality = 80, ...rest } = Astro.props;
const meta = media(src);
// 1x, 1.5x and 2x of the displayed size, never upscaled beyond the original
const widths = [...new Set([Math.round(w * 0.5), w, Math.round(w * 1.5), w * 2].filter((x) => x >= 100).map((x) => Math.min(x, meta.width)))].sort((a, b) => a - b);
const height = h ?? Math.round((w * meta.height) / meta.width);
---
<Image
  {...rest}
  src={meta}
  alt={alt}
  widths={widths}
  sizes={sizes ?? `(max-width: ${w}px) 100vw, ${w}px`}
  width={w}
  height={height}
  loading={loading}
  decoding="async"
  quality={quality}
  class={cls}
  style={`object-fit:${fit};${style ?? ''}`}
/>
