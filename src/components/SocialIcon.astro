---
/**
 * Inline SVG social icons, rendered at build time (no runtime dependency).
 * Brand glyphs come from the `simple-icons` package (CC0). Replaces the
 * Wix clip-art PNG icons the original site used.
 *
 * variant:
 *   color – coloured badges ("Jetzt anhören" row)
 *   white – white glyphs (home page footer)
 *   grey  – grey round Instagram badge (event pages)
 */
import { siSpotify, siApplemusic, siYoutube, siFacebook, siInstagram } from 'simple-icons';

type Name = 'spotify' | 'applemusic' | 'youtube' | 'facebook' | 'instagram';
interface Props { name: Name; variant?: 'color' | 'white' | 'grey'; size?: number; class?: string }
const { name, variant = 'color', size = 47, class: cls } = Astro.props;
const paths: Record<Name, string> = {
  spotify: siSpotify.path, applemusic: siApplemusic.path, youtube: siYoutube.path,
  facebook: siFacebook.path, instagram: siInstagram.path,
};
const p = paths[name];
const uid = `${name}-${variant}-${Math.random().toString(36).slice(2, 8)}`;
// bare "f" for the white footer variant (the original footer used a plain f, not the round badge)
const bareF = 'M13.6 22v-8.4h2.8l.45-3.3H13.6V8.2c0-.95.27-1.6 1.63-1.6h1.73V3.66c-.3-.04-1.33-.13-2.53-.13-2.5 0-4.2 1.53-4.2 4.33v2.44H7.4v3.3h2.83V22z';
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {variant === 'color' && name === 'spotify' && <path d={p} fill={`#${siSpotify.hex}`} />}
  {variant === 'color' && name === 'applemusic' && (
    <>
      <defs><linearGradient id={uid} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fa5b75" /><stop offset="1" stop-color="#fa233b" /></linearGradient></defs>
      <rect x="3" y="3" width="18" height="18" fill="#fff" />
      <path d={p} fill={`url(#${uid})`} />
    </>
  )}
  {variant === 'color' && name === 'youtube' && (<><rect x="8" y="7" width="9" height="10" fill="#fff" /><path d={p} fill={`#${siYoutube.hex}`} /></>)}
  {variant === 'color' && name === 'facebook' && (<><circle cx="12" cy="12" r="10.5" fill="#fff" /><path d={p} fill={`#${siFacebook.hex}`} /></>)}
  {variant === 'color' && name === 'instagram' && (
    <>
      <defs><linearGradient id={uid} x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#fdc829" /><stop offset=".45" stop-color="#fa3a55" /><stop offset="1" stop-color="#9b2fd6" /></linearGradient></defs>
      <path d={p} fill={`url(#${uid})`} />
    </>
  )}

  {variant === 'white' && name === 'facebook' && <path d={bareF} fill="#fff" />}
  {variant === 'white' && name === 'applemusic' && (
    <>
      <defs><clipPath id={uid}><circle cx="12" cy="12" r="12" /></clipPath></defs>
      <path d={p} fill="#fff" clip-path={`url(#${uid})`} transform="translate(12 12) scale(1.35) translate(-12 -12)" />
    </>
  )}
  {variant === 'white' && name !== 'facebook' && name !== 'applemusic' && <path d={p} fill="#fff" />}

  {variant === 'grey' && (
    <>
      <defs>
        <mask id={uid}>
          <circle cx="12" cy="12" r="12" fill="#fff" />
          <path d={p} fill="#000" transform="translate(12 12) scale(.56) translate(-12 -12)" />
        </mask>
      </defs>
      <circle cx="12" cy="12" r="12" fill="#8f8f8f" mask={`url(#${uid})`} />
    </>
  )}
</svg>
